<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Authors>Smash Phil</Authors>
    <Description>SDK for benchmarking and unit testing in RimWorld.</Description>
    <Product>DevTools.TestAdapter</Product>
    <RootNamespace>DevTools.TestAdapter</RootNamespace>
    <AssemblyName>DevTools.TestAdapter</AssemblyName>

    <OutDir>$(ModDir)\1.7\Assemblies\</OutDir>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <UseRimWorldRefs>false</UseRimWorldRefs>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TestPlatform.ObjectModel" Version="18.10.1" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Generated\" />
  </ItemGroup>
</Project>